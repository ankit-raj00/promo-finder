# Copy to .env and fill in. .env is ignored by git.
# Any OpenAI-compatible endpoint works. Example: a local OmniRoute gateway.
PROMO_FINDER_BASE_URL=http://localhost:20128/v1
PROMO_FINDER_API_KEY=your-key-here

# Models chosen in MODEL_SELECTION.md. Each step can use a different one.
PROMO_FINDER_MODEL=agy/gemini-3.8-flash-low
PROMO_FINDER_FALLBACK_MODEL=agy/gemini-3.8-flash-low
PROMO_FINDER_CRITIC_MODEL=agy/gemini-3.8-flash-low
PROMO_FINDER_SPOILER_MODEL=agy/gemini-3.8-flash-low
PROMO_FINDER_RANK_MODEL=agy/gemini-3.8-flash-low
PROMO_FINDER_MONTAGE_MODEL=agy/gemini-3.8-flash-low

# Lower this if you hit rate limits or run low on memory.
PROMO_FINDER_CONCURRENCY=2
