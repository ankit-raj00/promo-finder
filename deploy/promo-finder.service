[Unit]
Description=Promo Finder web app
After=network-online.target
Wants=network-online.target

[Service]
User=promo
WorkingDirectory=/opt/promo-finder/app
# Holds the AI key and PROMO_FINDER_DEMO_ONLY=1. Root-only, and never in the repo.
EnvironmentFile=/etc/promo-finder.env
Environment=HOME=/var/lib/promo-finder
StateDirectory=promo-finder
ExecStart=/opt/promo-finder/venv/bin/python -m uvicorn api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
MemoryMax=1500M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
